# Generated by sandcast: session environment for OpenShell sessions, whether
# started with a cleared environment or with the image environment. Safe to
# source more than once.
export MISE_DATA_DIR='/opt/mise'
export MISE_CONFIG_DIR='/etc/mise'
export MISE_CACHE_DIR='/tmp/sandcast-mise/cache'
export MISE_STATE_DIR='/tmp/sandcast-mise/state'
export MISE_TRUSTED_CONFIG_PATHS='/etc/mise'
export MISE_USE_VERSIONS_HOST='0'
_sandcast_path() {
	case "${PATH:-}" in
	/opt/mise/shims | /opt/mise/shims:*) ;;
	*) PATH="/opt/mise/shims${PATH:+:$PATH}" ;;
	esac
	export PATH
}
_sandcast_path
if [ -n "${BASH_VERSION:-}" ]; then
	eval '
	if [ "${BASH_VERSINFO[0]}" -gt 5 ] || { [ "${BASH_VERSINFO[0]}" -eq 5 ] && [ "${BASH_VERSINFO[1]}" -ge 1 ]; }; then
		case " ${PROMPT_COMMAND[*]-} " in
		*" _sandcast_path "*) ;;
		*)
			_sandcast_i=1
			for _sandcast_k in "${!PROMPT_COMMAND[@]}"; do
				[ "$_sandcast_k" -lt "$_sandcast_i" ] || _sandcast_i=$((_sandcast_k + 1))
			done
			PROMPT_COMMAND[_sandcast_i]=_sandcast_path
			unset _sandcast_i _sandcast_k
			;;
		esac
	else
		case ";${PROMPT_COMMAND-};" in
		*";_sandcast_path;"*) ;;
		*) PROMPT_COMMAND="_sandcast_path${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
		esac
	fi
	case $- in
	*i*) ;;
	*)
		if shopt -q login_shell; then
			trap '\''[ ${#BASH_SOURCE[@]} -eq 0 ] && { _sandcast_path; trap - DEBUG; }'\'' DEBUG
		fi
		;;
	esac
	'
fi
