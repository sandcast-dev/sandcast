# OpenShell sandbox policy generated by sandcast. Do not edit.
# Base: OpenShell v0.1.2 restrictive_default_policy() plus component image needs.
# Network rules come from provider profiles at runtime, never from this file.
version: 1
filesystem_policy:
  include_workdir: true
  read_only:
    - /bin
    - /dev/urandom
    - /etc
    - /lib
    - /opt/shared/lib
    - /opt/tools
    - /proc
    - /usr
  read_write:
    - /dev/null
    - /home/sandbox
    - /opt/mise
    - /tmp
    - /var/log
landlock:
  compatibility: best_effort
process:
  run_as_user: sandbox
  run_as_group: sandbox
network_policies: {}
