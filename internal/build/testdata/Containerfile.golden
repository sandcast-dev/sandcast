# Containerfile generated by sandcast dev from plan.yaml. Do not edit:
# change the manifest or the fragments in .sandcast/ and run sandcast build.
# target: openshell, platform: linux/arm64
# 00-header
FROM nvcr.io/nvidia/base/ubuntu:24.04@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 10-system-packages: system packages via apt-get
USER root
RUN mkdir -p /var/lib/apt/lists/partial \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      iproute2 \
      nftables \
      zsh \
 && rm -rf /var/lib/apt/lists/*

# 20-user: final user sandbox (uid 1000), created by sandcast
USER root
RUN <<'SANDCAST_EOF'
set -eu
if ! id -u sandbox >/dev/null 2>&1; then
  existing="$(getent passwd 1000 | cut -d: -f1 || true)"
  if [ -n "$existing" ]; then userdel -r "$existing" 2>/dev/null || userdel "$existing" 2>/dev/null || deluser "$existing"; fi
  oldgroup="$(getent group 1000 | cut -d: -f1 || true)"
  if [ -n "$oldgroup" ]; then groupdel "$oldgroup" 2>/dev/null || delgroup "$oldgroup" 2>/dev/null || true; fi
  if command -v useradd >/dev/null 2>&1; then
    groupadd -g 1000 sandbox
    useradd -m -u 1000 -g 1000 -d /home/sandbox -s /bin/zsh sandbox
  else
    addgroup -g 1000 sandbox
    adduser -D -u 1000 -G sandbox -h /home/sandbox -s /bin/zsh sandbox
  fi
fi
SANDCAST_EOF
RUN install -d -o sandbox -g sandbox /sandbox /opt/go \
 && install -d /opt/shared
ENV GOPATH=/opt/go
ENV GREETING="hello world"

# 30-mise: tools installed by mise v2026.10.4 in locked mode
USER root
ENV MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/etc/mise \
    MISE_CACHE_DIR=/tmp/sandcast-mise/cache \
    MISE_STATE_DIR=/tmp/sandcast-mise/state \
    MISE_TRUSTED_CONFIG_PATHS=/etc/mise \
    MISE_USE_VERSIONS_HOST=0 \
    PATH=/opt/mise/shims:$PATH
COPY mise/mise.toml mise/mise.lock /etc/mise/
COPY mise/sandcast-mise.sh /etc/profile.d/sandcast-mise.sh
RUN chmod 0644 /etc/mise/mise.toml /etc/mise/mise.lock /etc/profile.d/sandcast-mise.sh \
 && for attempt in 1 2 3; do \
      if curl -fsSL --connect-timeout 20 --max-time 300 -o /usr/local/bin/mise https://github.com/jdx/mise/releases/download/v2026.10.4/mise-v2026.10.4-linux-arm64-musl; then break; fi; \
      if [ "$attempt" = 3 ]; then echo "sandcast: could not download mise v2026.10.4 after 3 attempts: https://github.com/jdx/mise/releases/download/v2026.10.4/mise-v2026.10.4-linux-arm64-musl" >&2; exit 1; fi; \
      sleep 5; \
    done \
 && echo "7f92c8a883a489b31ef09862e9e198cc1b80ab32a67efebc9ae75146b7ea0e4c  /usr/local/bin/mise" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/mise \
 && install -d -o sandbox -g sandbox /opt/mise
USER sandbox
RUN (mise install --locked --yes || mise install --locked --yes) \
 && mise reshim \
 && rm -rf /tmp/sandcast-mise

# 40-recipes: mytool (components/mytool.yaml)
USER root
RUN <<'SANDCAST_EOF'
set -eux
echo mytool
SANDCAST_EOF

# 50-fragments: other-tool (.sandcast/fragments/other-tool.containerfile)
USER root
USER root
RUN echo other
USER sandbox

# 60-shell: curated zsh configuration relocated out of the overmounted home (ZDOTDIR)
USER root
COPY shell/sandcast.zsh /opt/sandcast/zdotdir/.zshrc
RUN chmod 0644 /opt/sandcast/zdotdir/.zshrc
RUN <<'SANDCAST_EOF'
set -eu
install -d /opt/sandcast/zdotdir /etc/zsh
zshenv_line='export ZDOTDIR=/opt/sandcast/zdotdir SANDCAST_SESSION=1 SHELL=/bin/zsh'
for f in /etc/zsh/zshenv /etc/zshenv; do
  if grep -qs '^export ZDOTDIR=.* SANDCAST_SESSION=1' "$f"; then
    echo "sandcast: replacing the ZDOTDIR export of a previous sandcast build in $f" >&2
    awk 'index($0, "export ZDOTDIR=") != 1 || index($0, " SANDCAST_SESSION=1") == 0' "$f" > "$f.sandcast"
  else
    cat "$f" > "$f.sandcast" 2>/dev/null || :
  fi
  printf '%s\n' "$zshenv_line" >> "$f.sandcast"
  mv "$f.sandcast" "$f"
  chmod 0644 "$f"
done
SANDCAST_EOF
RUN <<'SANDCAST_EOF'
set -eu
PATH="$PATH:/usr/sbin:/sbin"
grep -qxF /bin/zsh /etc/shells 2>/dev/null || printf '%s\n' /bin/zsh >> /etc/shells
if grep -q '^sandbox:' /etc/passwd; then
  if command -v usermod >/dev/null 2>&1; then
    usermod -s /bin/zsh sandbox
  else
    sed -i 's|^\(sandbox:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:\).*$|\1/bin/zsh|' /etc/passwd
  fi
fi
SANDCAST_EOF
RUN <<'SANDCAST_EOF'
set -eu
install -d /etc/profile.d /opt/sandcast/home
cat > /etc/profile.d/zz-sandcast-shell.sh <<'SANDCAST_HOOK'
# Written by sandcast: the home is the mounted workspace, so a login
# shell must never read a profile or logout file there. See
# docs/guides/build.md, the home model and shell initialization.
export ZDOTDIR=/opt/sandcast/zdotdir
export SHELL=/bin/zsh
if [ -n "${BASH_VERSION-}" ]; then
  if shopt -q login_shell 2>/dev/null; then
    case $- in
    *i*)
      if [ -n "${SANDCAST_SESSION-}" ]; then
        if [ -n "${BASH_EXECUTION_STRING+x}" ]; then exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"; fi
        exec "$BASH" --noprofile --norc -i
      fi
      SANDCAST_SESSION=1
      export SANDCAST_SESSION
      shopt -s execfail
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        exec /bin/zsh -l -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
        echo "sandcast: cannot execute /bin/zsh, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
      fi
      exec /bin/zsh -l -i
      echo "sandcast: cannot execute /bin/zsh, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
      exec "$BASH" --noprofile --norc -i
      ;;
    *)
      _sandcast_argc=$#
      _sandcast_rest=${SHELLOPTS-}
      while [ -n "$_sandcast_rest" ]; do
        case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
        case $_sandcast_opt in
        interactive | login_shell | monitor | history | emacs | vi | interactive-comments) ;;
        *) set -- "$@" -o "$_sandcast_opt" ;;
        esac
      done
      _sandcast_rest=${BASHOPTS-}
      while [ -n "$_sandcast_rest" ]; do
        case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
        case $_sandcast_opt in
        login_shell | interactive_comments) ;;
        *) set -- "$@" -O "$_sandcast_opt" ;;
        esac
      done
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        set -- "$@" -c "$BASH_EXECUTION_STRING" "$0"
      else
        case $0 in
        "$BASH" | "-$BASH" | "${BASH##*/}" | "-${BASH##*/}" | sh | -sh) set -- "$@" -s ;;
        *) set -- "$@" -- "$0" ;;
        esac
      fi
      while [ "$_sandcast_argc" -gt 0 ]; do set -- "$@" "$1"; shift; _sandcast_argc=$((_sandcast_argc - 1)); done
      exec "$BASH" --noprofile --norc "$@"
      ;;
    esac
  fi
elif [ -z "${ZSH_VERSION-}" ] && [ -n "${HOME-}" ] && [ "$HOME" != /opt/sandcast/home ]; then
  SANDCAST_HOME=$HOME
  HOME=/opt/sandcast/home
fi
SANDCAST_HOOK
chmod 0644 /etc/profile.d/zz-sandcast-shell.sh
cat > /opt/sandcast/home/.profile <<'SANDCAST_HOOK'
# Written by sandcast: the login hook pointed HOME here so the shell
# reads this file instead of a .profile in the mounted workspace.
# Restore the real home.
if [ -n "${SANDCAST_HOME-}" ]; then
  HOME=$SANDCAST_HOME
  unset SANDCAST_HOME
fi
SANDCAST_HOOK
chmod 0644 /opt/sandcast/home/.profile
cat > /tmp/sandcast-bashrc-hook <<'SANDCAST_HOOK'
# >>> sandcast shell hook >>>
# Written by sandcast: the home is the mounted workspace, so an
# interactive bash must never read a .bashrc there. Replace it with the
# curated shell before bash gets to the home file.
if [ -n "${BASH_VERSION-}" ]; then
  if [ "${SANDCAST_SHELL_PID-}" = "$$" ]; then
    unset SANDCAST_SHELL_PID
  elif ! shopt -q login_shell; then
    case $- in
    *i*)
      export ZDOTDIR=/opt/sandcast/zdotdir
      export SHELL=/bin/zsh
      if [ -n "${SANDCAST_SESSION-}" ]; then
        if [ -n "${BASH_EXECUTION_STRING+x}" ]; then exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"; fi
        exec "$BASH" --noprofile --norc -i
      fi
      SANDCAST_SESSION=1
      export SANDCAST_SESSION
      shopt -s execfail
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        exec /bin/zsh -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
        echo "sandcast: cannot execute /bin/zsh, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
      fi
      exec /bin/zsh -i
      echo "sandcast: cannot execute /bin/zsh, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
      exec "$BASH" --noprofile --norc -i
      ;;
    *)
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        _sandcast_argc=$#
        _sandcast_rest=${SHELLOPTS-}
        while [ -n "$_sandcast_rest" ]; do
          case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
          case $_sandcast_opt in
          interactive | login_shell | monitor | history | emacs | vi | interactive-comments) ;;
          *) set -- "$@" -o "$_sandcast_opt" ;;
          esac
        done
        _sandcast_rest=${BASHOPTS-}
        while [ -n "$_sandcast_rest" ]; do
          case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
          case $_sandcast_opt in
          login_shell | interactive_comments) ;;
          *) set -- "$@" -O "$_sandcast_opt" ;;
          esac
        done
        set -- "$@" -c "$BASH_EXECUTION_STRING" "$0"
        while [ "$_sandcast_argc" -gt 0 ]; do set -- "$@" "$1"; shift; _sandcast_argc=$((_sandcast_argc - 1)); done
        exec "$BASH" --noprofile --norc "$@"
      fi
      ;;
    esac
  fi
fi
# <<< sandcast shell hook <<<
SANDCAST_HOOK
sysrc=
bash_bin=$(command -v bash 2>/dev/null || true)
if [ -n "$bash_bin" ]; then
  for f in /etc/bash.bashrc /etc/bash/bashrc; do
    if grep -qsF "$f" "$bash_bin"; then sysrc=$f; break; fi
  done
fi
if [ -n "$sysrc" ]; then
  install -d "$(dirname "$sysrc")"
  hook=/tmp/sandcast-bashrc-hook hook_begin='# >>> sandcast shell hook >>>' hook_end='# <<< sandcast shell hook <<<'
  if grep -qsF "$hook_begin" "$sysrc"; then
    echo "sandcast: replacing the shell hook block of a previous sandcast build in $sysrc" >&2
    awk -v b="$hook_begin" -v e="$hook_end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$sysrc" > "$sysrc.sandcast.rest"
  else
    cat "$sysrc" > "$sysrc.sandcast.rest" 2>/dev/null || :
  fi
  { cat "$hook"; cat "$sysrc.sandcast.rest"; } > "$sysrc.sandcast"
  rm -f "$sysrc.sandcast.rest"
  mv "$sysrc.sandcast" "$sysrc"
  chmod 0644 "$sysrc"
elif [ -n "$bash_bin" ]; then
  echo "sandcast: $bash_bin reads no system bashrc, so an interactive non-login bash that a runtime starts directly cannot be hooked" >&2
fi
rm -f /tmp/sandcast-bashrc-hook
SANDCAST_EOF

# 80-policy: OpenShell sandbox policy (filesystem, landlock, process; no network entries)
USER root
COPY policy.yaml /etc/openshell/policy.yaml
RUN chmod 0644 /etc/openshell/policy.yaml

# 90-footer
WORKDIR /sandbox
USER sandbox
ENTRYPOINT []
CMD ["/bin/zsh", "-l"]
