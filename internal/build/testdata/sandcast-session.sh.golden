# Generated by sandcast: the image environment for shell sessions.
# OpenShell starts sessions with a cleared environment, so the variables the
# image sets with ENV are exported again for login shells and every zsh.
export GOPATH='/opt/go'
export GREETING='hello world'
export MISE_DATA_DIR='/opt/mise'
export MISE_CONFIG_DIR='/etc/mise'
export MISE_CACHE_DIR='/tmp/sandcast-mise/cache'
export MISE_STATE_DIR='/tmp/sandcast-mise/state'
export MISE_TRUSTED_CONFIG_PATHS='/etc/mise'
export MISE_USE_VERSIONS_HOST='0'
case ":${PATH}:" in
  *":/opt/mise/shims:"*) ;;
  *) PATH="/opt/mise/shims:${PATH}" ;;
esac
export PATH
