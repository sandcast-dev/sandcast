# Containerfile generated by sandcast dev from plan.yaml. Do not edit:
# change the manifest or the fragments in .sandcast/ and run sandcast build.
# target: container, platform: linux/arm64
# 00-header
FROM nvcr.io/nvidia/base/ubuntu:24.04@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 10-system-packages: system packages via apt-get
USER root
RUN mkdir -p /var/lib/apt/lists/partial \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      iproute2 \
      nftables \
      zsh \
 && rm -rf /var/lib/apt/lists/*

# 20-user: final user root (uid 0)
USER root
RUN install -d -o root -g root /opt/go \
 && install -d /opt/shared
ENV GOPATH=/opt/go
ENV GREETING="hello world"

# 30-mise: tools installed by mise v2026.10.4 in locked mode
USER root
ENV MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/etc/mise \
    MISE_CACHE_DIR=/tmp/sandcast-mise/cache \
    MISE_STATE_DIR=/tmp/sandcast-mise/state \
    MISE_TRUSTED_CONFIG_PATHS=/etc/mise \
    MISE_USE_VERSIONS_HOST=0 \
    PATH=/opt/mise/shims:$PATH
COPY mise/mise.toml mise/mise.lock /etc/mise/
RUN chmod 0644 /etc/mise/mise.toml /etc/mise/mise.lock \
 && for attempt in 1 2 3; do \
      if curl -fsSL --connect-timeout 20 --max-time 300 -o /usr/local/bin/mise https://github.com/jdx/mise/releases/download/v2026.10.4/mise-v2026.10.4-linux-arm64-musl; then break; fi; \
      if [ "$attempt" = 3 ]; then echo "sandcast: could not download mise v2026.10.4 after 3 attempts: https://github.com/jdx/mise/releases/download/v2026.10.4/mise-v2026.10.4-linux-arm64-musl" >&2; exit 1; fi; \
      sleep 5; \
    done \
 && echo "7f92c8a883a489b31ef09862e9e198cc1b80ab32a67efebc9ae75146b7ea0e4c  /usr/local/bin/mise" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/mise \
 && install -d -o sandbox -g sandbox /opt/mise
USER sandbox
RUN (mise install --locked --yes || mise install --locked --yes) \
 && mise reshim \
 && rm -rf /tmp/sandcast-mise

# 40-recipes: mytool (components/mytool.yaml)
USER root
RUN <<'SANDCAST_EOF'
set -eux
echo mytool
SANDCAST_EOF

# 50-fragments: other-tool (.sandcast/fragments/other-tool.containerfile)
USER root
USER root
RUN echo other
USER sandbox

# 60-shell: curated zsh configuration relocated out of the overmounted home (ZDOTDIR)
USER root
RUN <<'SANDCAST_EOF'
set -eu
sandcast_legacy_strip() {
  [ -f "$1" ] || return 0
  if grep -qsF -e '# sandcast: session environment' -e '# sandcast: switch interactive terminal sessions to zsh' \
       -e '[ -r /etc/zsh/zshrc.d/sandcast.zsh ] && . /etc/zsh/zshrc.d/sandcast.zsh' -e '[ -r /etc/profile.d/sandcast.sh ] && . /etc/profile.d/sandcast.sh' "$1"; then
    echo "sandcast: removing the shell configuration of a previous sandcast build from $1" >&2
    awk '
      $0 == "# sandcast: session environment" { skip = 1; next }
      $0 == "# sandcast: switch interactive terminal sessions to zsh" { skip = 1; next }
      skip > 0 { skip--; next }
      $0 == "zsh-newuser-install() { :; }" { next }
      $0 == "[ -r /etc/zsh/zshrc.d/sandcast.zsh ] && . /etc/zsh/zshrc.d/sandcast.zsh" { next }
      $0 == "[ -r /etc/profile.d/sandcast.sh ] && . /etc/profile.d/sandcast.sh" { next }
      { print }
    ' "$1" > "$1.sandcast" && mv "$1.sandcast" "$1"
  fi
}
sandcast_legacy_unhook() {
  [ -f "$1" ] || return 0
  if grep -qsF '# >>> sandcast shell hook >>>' "$1"; then
    echo "sandcast: removing the shell hook block of a previous sandcast build from $1" >&2
    awk -v b='# >>> sandcast shell hook >>>' -v e='# <<< sandcast shell hook <<<' '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$1" > "$1.sandcast" && mv "$1.sandcast" "$1"
  fi
}
sandcast_legacy_remove() {
  [ -f "$1" ] || return 0
  if [ $# -gt 1 ]; then
    case $(head -n 1 "$1") in "$2"*) ;; *) return 0 ;; esac
  fi
  echo "sandcast: removing $1 of a previous sandcast build" >&2
  rm -f "$1"
}
for f in /etc/bash.bashrc /etc/bashrc /etc/bash/bashrc /etc/zsh/zshrc /etc/zshrc /etc/zsh/zshenv /etc/zshenv; do
  sandcast_legacy_strip "$f"
done
for f in /etc/bash.bashrc /etc/bash/bashrc; do
  sandcast_legacy_unhook "$f"
done
for f in /etc/zsh/zshrc.d/sandcast.zsh /etc/profile.d/sandcast.sh /etc/profile.d/zz-sandcast-shell.sh; do
  sandcast_legacy_remove "$f"
done
sandcast_legacy_remove /etc/profile.d/sandcast-mise.sh '# Generated by sandcast: keep mise shims on PATH'
SANDCAST_EOF
COPY shell/sandcast-env.sh /etc/profile.d/sandcast-env.sh
RUN chmod 0644 /etc/profile.d/sandcast-env.sh
COPY shell/sandcast.zsh /opt/sandcast/zdotdir/.zshrc
RUN chmod 0644 /opt/sandcast/zdotdir/.zshrc
RUN <<'SANDCAST_EOF'
set -eu
install -d /opt/sandcast/zdotdir /etc/zsh
zshenv_block=/tmp/sandcast-zshenv zshenv_begin='# >>> sandcast zshenv >>>' zshenv_end='# <<< sandcast zshenv <<<'
cat > "$zshenv_block" <<'SANDCAST_ZSHENV'
# >>> sandcast zshenv >>>
export ZDOTDIR=/opt/sandcast/zdotdir SANDCAST_SESSION=1 SHELL=/bin/zsh
[ -r /etc/profile.d/sandcast-env.sh ] && . /etc/profile.d/sandcast-env.sh
zsh-newuser-install() { :; }
# <<< sandcast zshenv <<<
SANDCAST_ZSHENV
for f in /etc/zsh/zshenv /etc/zshenv; do
  if grep -qsF "$zshenv_begin" "$f" || grep -qs '^export ZDOTDIR=.* SANDCAST_SESSION=1' "$f"; then
    echo "sandcast: replacing the zshenv block of a previous sandcast build in $f" >&2
    awk -v b="$zshenv_begin" -v e="$zshenv_end" '$0 == b { skip = 1 } !skip && !(index($0, "export ZDOTDIR=") == 1 && index($0, " SANDCAST_SESSION=1") > 0) { print } $0 == e { skip = 0 }' "$f" > "$f.sandcast"
  else
    cat "$f" > "$f.sandcast" 2>/dev/null || :
  fi
  cat "$zshenv_block" >> "$f.sandcast"
  mv "$f.sandcast" "$f"
  chmod 0644 "$f"
done
rm -f "$zshenv_block"
SANDCAST_EOF
RUN <<'SANDCAST_EOF'
set -eu
PATH="$PATH:/usr/sbin:/sbin"
grep -qxF /bin/zsh /etc/shells 2>/dev/null || printf '%s\n' /bin/zsh >> /etc/shells
if grep -q '^root:' /etc/passwd; then
  if command -v usermod >/dev/null 2>&1; then
    usermod -s /bin/zsh root
  else
    sed -i 's|^\(root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:\).*$|\1/bin/zsh|' /etc/passwd
  fi
fi
SANDCAST_EOF

# 90-footer
WORKDIR /root
USER root
ENTRYPOINT []
CMD ["/bin/zsh", "-l"]
