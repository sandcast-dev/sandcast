# 60-shell: curated bash configuration with a baked login launcher (no $HOME startup files)
USER root
RUN <<'SANDCAST_EOF'
set -eu
sandcast_legacy_strip() {
  [ -f "$1" ] || return 0
  if grep -qsF -e '# sandcast: session environment' -e '# sandcast: switch interactive terminal sessions to zsh' \
       -e '[ -r /etc/zsh/zshrc.d/sandcast.zsh ] && . /etc/zsh/zshrc.d/sandcast.zsh' -e '[ -r /etc/profile.d/sandcast.sh ] && . /etc/profile.d/sandcast.sh' "$1"; then
    echo "sandcast: removing the shell configuration of a previous sandcast build from $1" >&2
    awk '
      $0 == "# sandcast: session environment" { skip = 1; next }
      $0 == "# sandcast: switch interactive terminal sessions to zsh" { skip = 1; next }
      skip > 0 { skip--; next }
      $0 == "zsh-newuser-install() { :; }" { next }
      $0 == "[ -r /etc/zsh/zshrc.d/sandcast.zsh ] && . /etc/zsh/zshrc.d/sandcast.zsh" { next }
      $0 == "[ -r /etc/profile.d/sandcast.sh ] && . /etc/profile.d/sandcast.sh" { next }
      { print }
    ' "$1" > "$1.sandcast" && mv "$1.sandcast" "$1"
  fi
}
for f in /etc/bash.bashrc /etc/bashrc /etc/bash/bashrc /etc/zsh/zshrc /etc/zshrc /etc/zsh/zshenv /etc/zshenv; do
  sandcast_legacy_strip "$f"
done
for f in /etc/zsh/zshrc.d/sandcast.zsh /etc/profile.d/sandcast.sh; do
  if [ -f "$f" ]; then
    echo "sandcast: removing the curated rc of a previous sandcast build $f" >&2
    rm -f "$f"
  fi
done
SANDCAST_EOF
COPY shell/sandcast-env.sh /etc/profile.d/sandcast-env.sh
RUN chmod 0644 /etc/profile.d/sandcast-env.sh
RUN install -d /opt/sandcast
COPY shell/sandcast.sh /opt/sandcast/bashrc
RUN chmod 0644 /opt/sandcast/bashrc
RUN <<'SANDCAST_EOF'
set -eu
cat > /opt/sandcast/shell-login <<'SANDCAST_LAUNCH'
#!/bin/sh
# Written by sandcast: bash under the OpenShell home overmount must never
# read a startup file from the workspace home. Launch bash with no profile
# files and the baked rcfile in place of the home .bashrc.
[ -r /etc/profile.d/sandcast-env.sh ] && . /etc/profile.d/sandcast-env.sh
SANDCAST_SESSION=1
export SANDCAST_SESSION
# Drop -l and --login (also inside a cluster such as -lc) from the options
# before the command string, script name or "--", so the shell never becomes
# a login shell. Arguments from there on are kept as they are. The scan also
# records -i, -c, -s and whether an operand was given.
_sandcast_opts=1 _sandcast_oarg= _sandcast_i= _sandcast_c= _sandcast_s= _sandcast_arg=
for _sandcast_a do
  shift
  if [ -n "$_sandcast_oarg" ]; then
    _sandcast_oarg=
  elif [ -n "$_sandcast_opts" ]; then
    case $_sandcast_a in
    --login) continue ;;
    -- | -) _sandcast_opts= ;;
    --rcfile | --init-file) _sandcast_oarg=1 ;;
    --*) ;;
    [-+]o | [-+]O) _sandcast_oarg=1 ;;
    -*)
      while :; do
        case $_sandcast_a in
        -*l*) _sandcast_a=${_sandcast_a%%l*}${_sandcast_a#*l} ;;
        *) break ;;
        esac
      done
      case $_sandcast_a in -*i*) _sandcast_i=1 ;; esac
      case $_sandcast_a in -*c*) _sandcast_c=1 ;; esac
      case $_sandcast_a in -*s*) _sandcast_s=1 ;; esac
      case $_sandcast_a in
      -) continue ;;
      *[oO]) _sandcast_oarg=1 ;;
      esac
      ;;
    +*) case $_sandcast_a in *[oO]) _sandcast_oarg=1 ;; esac ;;
    *) _sandcast_opts= _sandcast_arg=1 ;;
    esac
  else
    _sandcast_arg=1
  fi
  set -- "$@" "$_sandcast_a"
done
# Export the pid guard only for a bash that will be interactive: only that
# bash reads the system bashrc, whose hook unsets the guard again. Any other
# bash would pass it on to every descendant.
if [ -n "$_sandcast_i" ] || { [ -z "$_sandcast_c" ] && { [ -n "$_sandcast_s" ] || [ -z "$_sandcast_arg" ]; } && [ -t 0 ] && [ -t 2 ]; }; then
  SANDCAST_SHELL_PID=$$
  export SANDCAST_SHELL_PID
else
  unset SANDCAST_SHELL_PID
fi
exec bash --noprofile --rcfile /opt/sandcast/bashrc "$@"
SANDCAST_LAUNCH
bash_bin=$(PATH=/usr/local/bin:/usr/bin:/bin command -v bash)
sed -i "s|^exec bash |exec $bash_bin |" /opt/sandcast/shell-login
grep -q "^exec $bash_bin " /opt/sandcast/shell-login
chmod 0755 /opt/sandcast/shell-login
SANDCAST_EOF
RUN <<'SANDCAST_EOF'
set -eu
PATH="$PATH:/usr/sbin:/sbin"
grep -qxF /opt/sandcast/shell-login /etc/shells 2>/dev/null || printf '%s\n' /opt/sandcast/shell-login >> /etc/shells
if grep -q '^sandbox:' /etc/passwd; then
  if command -v usermod >/dev/null 2>&1; then
    usermod -s /opt/sandcast/shell-login sandbox
  else
    sed -i 's|^\(sandbox:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:\).*$|\1/opt/sandcast/shell-login|' /etc/passwd
  fi
fi
SANDCAST_EOF
RUN <<'SANDCAST_EOF'
set -eu
install -d /etc/profile.d /opt/sandcast/home
cat > /etc/profile.d/zz-sandcast-shell.sh <<'SANDCAST_HOOK'
# Written by sandcast: the home is the mounted workspace, so a login
# shell must never read a profile or logout file there. See
# docs/guides/build.md, the home model and shell initialization.
[ -r /etc/profile.d/sandcast-env.sh ] && . /etc/profile.d/sandcast-env.sh
if [ -n "${BASH_VERSION-}" ]; then
  if shopt -q login_shell 2>/dev/null; then
    case $- in
    *i*)
      SANDCAST_SESSION=1
      export SANDCAST_SESSION
      shopt -s execfail
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        exec /opt/sandcast/shell-login -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
        echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
      fi
      if [ $# -gt 0 ]; then
        exec /opt/sandcast/shell-login -i -s -- "$@"
        echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -s -- "$@"
      fi
      exec /opt/sandcast/shell-login -i
      echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
      exec "$BASH" --noprofile --norc -i
      ;;
    *)
      _sandcast_argc=$#
      _sandcast_rest=${SHELLOPTS-}
      while [ -n "$_sandcast_rest" ]; do
        case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
        case $_sandcast_opt in
        interactive | login_shell | monitor | history | emacs | vi | interactive-comments) ;;
        *) set -- "$@" -o "$_sandcast_opt" ;;
        esac
      done
      _sandcast_rest=${BASHOPTS-}
      while [ -n "$_sandcast_rest" ]; do
        case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
        case $_sandcast_opt in
        login_shell | interactive_comments) ;;
        *) set -- "$@" -O "$_sandcast_opt" ;;
        esac
      done
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        set -- "$@" -c "$BASH_EXECUTION_STRING" "$0"
      else
        case $0 in
        "$BASH" | "-$BASH" | "${BASH##*/}" | "-${BASH##*/}" | sh | -sh) set -- "$@" -s ;;
        *) set -- "$@" -- "$0" ;;
        esac
      fi
      while [ "$_sandcast_argc" -gt 0 ]; do set -- "$@" "$1"; shift; _sandcast_argc=$((_sandcast_argc - 1)); done
      exec "$BASH" --noprofile --norc "$@"
      ;;
    esac
  fi
elif [ -z "${ZSH_VERSION-}" ] && [ -n "${HOME-}" ] && [ "$HOME" != /opt/sandcast/home ]; then
  SANDCAST_HOME=$HOME
  HOME=/opt/sandcast/home
fi
SANDCAST_HOOK
chmod 0644 /etc/profile.d/zz-sandcast-shell.sh
cat > /opt/sandcast/home/.profile <<'SANDCAST_HOOK'
# Written by sandcast: the login hook pointed HOME here so the shell
# reads this file instead of a .profile in the mounted workspace.
# Restore the real home.
if [ -n "${SANDCAST_HOME-}" ]; then
  HOME=$SANDCAST_HOME
  unset SANDCAST_HOME
fi
SANDCAST_HOOK
chmod 0644 /opt/sandcast/home/.profile
cat > /tmp/sandcast-bashrc-hook <<'SANDCAST_HOOK'
# >>> sandcast shell hook >>>
# Written by sandcast: the home is the mounted workspace, so an
# interactive bash must never read a .bashrc there. Replace it with the
# curated shell before bash gets to the home file.
[ -r /etc/profile.d/sandcast-env.sh ] && . /etc/profile.d/sandcast-env.sh
if [ -n "${BASH_VERSION-}" ]; then
  if [ "${SANDCAST_SHELL_PID-}" = "$$" ]; then
    unset SANDCAST_SHELL_PID
  elif ! shopt -q login_shell; then
    case $- in
    *i*)
      SANDCAST_SESSION=1
      export SANDCAST_SESSION
      shopt -s execfail
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        exec /opt/sandcast/shell-login -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
        echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -c "$BASH_EXECUTION_STRING" "$0" "$@"
      fi
      if [ $# -gt 0 ]; then
        exec /opt/sandcast/shell-login -i -s -- "$@"
        echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
        exec "$BASH" --noprofile --norc -i -s -- "$@"
      fi
      exec /opt/sandcast/shell-login -i
      echo "sandcast: cannot execute /opt/sandcast/shell-login, the curated shell; it is missing from the image or the sandbox policy does not grant it (sandcast grants /opt/sandcast read-only in /etc/openshell/policy.yaml); starting bash without startup files instead" >&2
      exec "$BASH" --noprofile --norc -i
      ;;
    *)
      if [ -n "${BASH_EXECUTION_STRING+x}" ]; then
        _sandcast_argc=$#
        _sandcast_rest=${SHELLOPTS-}
        while [ -n "$_sandcast_rest" ]; do
          case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
          case $_sandcast_opt in
          interactive | login_shell | monitor | history | emacs | vi | interactive-comments) ;;
          *) set -- "$@" -o "$_sandcast_opt" ;;
          esac
        done
        _sandcast_rest=${BASHOPTS-}
        while [ -n "$_sandcast_rest" ]; do
          case $_sandcast_rest in *:*) _sandcast_opt=${_sandcast_rest%%:*} _sandcast_rest=${_sandcast_rest#*:} ;; *) _sandcast_opt=$_sandcast_rest _sandcast_rest= ;; esac
          case $_sandcast_opt in
          login_shell | interactive_comments) ;;
          *) set -- "$@" -O "$_sandcast_opt" ;;
          esac
        done
        set -- "$@" -c "$BASH_EXECUTION_STRING" "$0"
        while [ "$_sandcast_argc" -gt 0 ]; do set -- "$@" "$1"; shift; _sandcast_argc=$((_sandcast_argc - 1)); done
        exec "$BASH" --noprofile --norc "$@"
      fi
      ;;
    esac
  fi
fi
# <<< sandcast shell hook <<<
SANDCAST_HOOK
sysrc=
bash_bin=$(command -v bash 2>/dev/null || true)
if [ -n "$bash_bin" ]; then
  for f in /etc/bash.bashrc /etc/bash/bashrc; do
    if grep -qsF "$f" "$bash_bin"; then sysrc=$f; break; fi
  done
fi
if [ -n "$sysrc" ]; then
  install -d "$(dirname "$sysrc")"
  hook=/tmp/sandcast-bashrc-hook hook_begin='# >>> sandcast shell hook >>>' hook_end='# <<< sandcast shell hook <<<'
  if grep -qsF "$hook_begin" "$sysrc"; then
    echo "sandcast: replacing the shell hook block of a previous sandcast build in $sysrc" >&2
    awk -v b="$hook_begin" -v e="$hook_end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$sysrc" > "$sysrc.sandcast.rest"
  else
    cat "$sysrc" > "$sysrc.sandcast.rest" 2>/dev/null || :
  fi
  { cat "$hook"; cat "$sysrc.sandcast.rest"; } > "$sysrc.sandcast"
  rm -f "$sysrc.sandcast.rest"
  mv "$sysrc.sandcast" "$sysrc"
  chmod 0644 "$sysrc"
elif [ -n "$bash_bin" ]; then
  echo "sandcast: $bash_bin reads no system bashrc, so an interactive non-login bash that a runtime starts directly cannot be hooked" >&2
fi
rm -f /tmp/sandcast-bashrc-hook
SANDCAST_EOF
